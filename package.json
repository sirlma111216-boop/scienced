{
  "name": "science-lesson-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "경희대학교 「과학교육론」·「과학교과교수법」 18차시 강의용 웹앱",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "firebase:login": "npx --yes --package=firebase-tools firebase login",
    "deploy:rules": "npx --yes --package=firebase-tools firebase deploy --only firestore:rules",
    "emulators": "node scripts/emulators.mjs",
    "test:flow": "node scripts/test-flow.mjs",
    "test:rules": "node scripts/test-rules.mjs",
    "migrate:classes": "node scripts/migrate-to-classes.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "verify:ladder": "node --import ./scripts/_loader.mjs scripts/verify-ladder.mjs",
    "verify:lessons": "node --import ./scripts/_loader.mjs scripts/verify-lessons.mjs",
    "verify:classes": "node --import ./scripts/_loader.mjs scripts/verify-classes.mjs",
    "verify:content": "node --import ./scripts/_loader.mjs scripts/verify-content.mjs",
    "verify:wording": "node --import ./scripts/_loader.mjs scripts/verify-wording.mjs",
    "verify:api": "node --import ./scripts/_loader.mjs scripts/verify-api.mjs",
    "verify:tiers": "node --import ./scripts/_loader.mjs scripts/verify-tiers.mjs",
    "verify:standards": "node --import ./scripts/_loader.mjs scripts/verify-standards.mjs",
    "verify:games": "node --import ./scripts/_loader.mjs scripts/verify-games.mjs",
    "verify:modules": "node --import ./scripts/_loader.mjs scripts/verify-modules.mjs",
    "verify:wall": "node --import ./scripts/_loader.mjs scripts/verify-wall.mjs",
    "verify:a11y": "node --import ./scripts/_loader.mjs scripts/verify-a11y.mjs",
    "verify:publish": "node --import ./scripts/_loader.mjs scripts/verify-publish.mjs",
    "verify": "node scripts/verify-all.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "firebase": "^10.12.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.1"
  }
}
