# ─────────────────────────────────────────────────────────────
# 서버 전용 — Cloudflare Pages 대시보드의 환경 변수에만 넣는다.
# VITE_ 접두사를 붙이지 않는다. 붙이면 번들에 들어가 공개된다.
# ─────────────────────────────────────────────────────────────

# Vertex AI + Identity Toolkit 공용 서비스 계정 JSON (한 줄로)
# 이것이 이 프로젝트의 유일한 진짜 비밀이다. 절대 커밋하지 않는다.
GCP_SERVICE_ACCOUNT=

# 모델명을 하드코딩하지 않는다. 이 변수로 바꾼다.
GEN_AI_MODEL=gemini-2.5-flash-lite
GEN_AI_LOCATION=us-central1

# 분당 AI 호출 한도
AI_RATE_PER_MIN=6

FIREBASE_PROJECT_ID=scienced-e721d
STUDENT_EMAIL_DOMAIN=students.slstudio.local


# ─────────────────────────────────────────────────────────────
# 클라이언트 — Firebase 웹 설정값.
# 이 값들은 공개되어도 무방하다. 보안은 firestore.rules 가 한다.
# (Firebase 문서가 명시하는 설계다. 아래 값은 이 프로젝트의 실제 값이다.)
# ─────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=AIzaSyC1D0zrRRGqL6SBqz3r7KzeOVMUqq1H-bs
VITE_FIREBASE_AUTH_DOMAIN=scienced-e721d.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=scienced-e721d
VITE_FIREBASE_STORAGE_BUCKET=scienced-e721d.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=867556829262
VITE_FIREBASE_APP_ID=1:867556829262:web:c72f77b5a3a6a909b5fb1f

# 학번 2024123456 → 2024123456@students.slstudio.local
# 존재하지 않는 도메인을 쓴다. 메일 발송 기능은 사용하지 않는다.
VITE_STUDENT_EMAIL_DOMAIN=students.slstudio.local

# 앱은 더 이상 이것을 쓰지 않는다. 학기는 「수강 클래스」 화면에서 만든다(2차 A).
# 옛 courses/* 구조에서 자료를 옮길 때 마이그레이션 스크립트만 읽는다.
#   COURSE_ID=khu-science-2026 node scripts/migrate-to-classes.mjs
