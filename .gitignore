node_modules/
dist/
.wrangler/
*.tsbuildinfo

# 서비스 계정이 들어가는 파일. 절대 커밋하지 않는다.
.env
.env.local
.env.*.local

*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/

# 원본 참조 자료 (교재 PDF·DOCX 등)는 저장소에 올리지 않는다
reference/
*.docx
*.pdf

# tsc 가 소스 옆에 뱉는 .js. 이 세 폴더는 전부 .ts/.tsx 라 .js 는 산출물뿐이다.
# 한 번 실수로 68개가 커밋된 적이 있다. 그때는 typecheck 스크립트가 --noEmit 을 껐었다.
/src/**/*.js
/shared/**/*.js
/functions/**/*.js
/vite.config.js
